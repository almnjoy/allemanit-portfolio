---
// Primary = the work. "More" = personal pages + the other brands.
// Desktop: primary links + a More menu (details/summary, works without JS).
// Mobile: one panel, grouped, every row a 48px tap target.
const primary = [
  { href: '/projects/', label: 'Projects' },
  { href: '/design-lab/', label: 'Design' },
  { href: '/games/', label: 'Games' },
  { href: '/blog/', label: 'Blog' },
  { href: '/repos/', label: 'Repos' },
];
const more = [
  { href: '/daily', label: 'Daily' },
  { href: '/music', label: 'Music' },
  { href: '/resume/', label: 'Resume' },
  { href: 'https://family.allemanit.com', label: 'Family', external: true },
  { href: 'https://quickitprojects.com', label: 'Business', external: true },
];
const cta = { href: 'https://madeformeai.com/#story', label: 'Try Your Own AI' };
const path = Astro.url.pathname;
const isActive = (href) => !href.startsWith('http') && href !== '/' && path.startsWith(href.replace(/\/$/, ''));
const ext = (l) => (l.external ? { target: '_blank', rel: 'noopener' } : {});
---
<header class="sticky top-0 z-40 border-b border-white/10 bg-ink-950/80 backdrop-blur">
  <nav class="container-x flex h-16 items-center justify-between" aria-label="Main">
    <a href="/" class="flex items-center gap-2" aria-label="AllemanIT home">
      <img src="/AllemanITLogo.svg" alt="AllemanIT" class="h-8 w-auto" />
    </a>

    <!-- desktop -->
    <div class="hidden items-center gap-6 md:flex">
      {primary.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined} class={`text-sm transition hover:text-white ${isActive(l.href) ? 'text-white' : 'text-white/70'}`}>{l.label}</a>
      ))}
      <details class="nav-more relative">
        <summary class="flex cursor-pointer list-none items-center gap-1 text-sm text-white/70 hover:text-white">More <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary>
        <div class="absolute right-0 top-8 w-44 rounded-xl border border-white/10 bg-ink-950/95 p-1.5 shadow-2xl backdrop-blur">
          {more.map((l) => (
            <a href={l.href} {...ext(l)} class="block rounded-lg px-3 py-2 text-sm text-white/80 hover:bg-white/5 hover:text-white">{l.label}{l.external && <span aria-hidden="true" class="text-white/40"> ↗</span>}</a>
          ))}
        </div>
      </details>
      <a href={cta.href} data-umami-event="outbound-click" data-umami-event-site="allemanit" data-umami-event-destination="madeformeai" data-umami-event-placement="nav" target="_blank" rel="noopener" class="rounded-lg bg-brand-orange px-3.5 py-1.5 text-sm font-semibold text-white transition hover:brightness-110">{cta.label}</a>
    </div>

    <!-- mobile toggle -->
    <button id="navToggle" class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-white/15 text-white/80 md:hidden" aria-label="Menu" aria-expanded="false" aria-controls="navPanel">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </nav>

  <!-- mobile panel -->
  <div id="navPanel" class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-white/10 bg-ink-950/95 backdrop-blur md:hidden">
    <div class="container-x py-3">
      <p class="pt-1 text-[11px] font-semibold uppercase tracking-[0.2em] text-white/40">Work</p>
      <div class="flex flex-col">
        {primary.map((l) => (
          <a href={l.href} class={`flex min-h-[48px] items-center border-b border-white/5 text-base font-medium ${isActive(l.href) ? 'text-brand-orange' : 'text-white/90'}`}>{l.label}</a>
        ))}
      </div>
      <p class="mt-4 text-[11px] font-semibold uppercase tracking-[0.2em] text-white/40">More</p>
      <div class="grid grid-cols-2 gap-x-4">
        {more.map((l) => (
          <a href={l.href} {...ext(l)} class="flex min-h-[48px] items-center border-b border-white/5 text-base text-white/80">{l.label}{l.external && <span aria-hidden="true" class="ml-1 text-white/40">↗</span>}</a>
        ))}
      </div>
      <a href={cta.href} data-umami-event="outbound-click" data-umami-event-site="allemanit" data-umami-event-destination="madeformeai" data-umami-event-placement="nav-mobile" target="_blank" rel="noopener" class="mt-4 mb-2 block rounded-lg bg-brand-orange px-4 py-3 text-center text-base font-semibold text-white">{cta.label}</a>
    </div>
  </div>

  <script>
    const t = document.getElementById('navToggle');
    const p = document.getElementById('navPanel');
    t?.addEventListener('click', () => {
      const open = p.classList.toggle('hidden') === false;
      t.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    // close the desktop More menu on outside click / Escape
    const d = document.querySelector('.nav-more');
    document.addEventListener('click', (e) => { if (d && d.open && !d.contains(e.target)) d.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { if (d) d.open = false; p?.classList.add('hidden'); t?.setAttribute('aria-expanded', 'false'); } });
  </script>
</header>
