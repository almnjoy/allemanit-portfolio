---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
const {
  title = 'Dustin Alleman | Network Engineer and Builder, Chicago',
  description = 'Dustin Alleman, Chicago network engineer with 10+ years in Cisco and Meraki. AI agents, automation, a production homelab and the projects built on top.',
  image = 'https://allemanit.com/og.png',
  url = 'https://allemanit.com/',
  favicon = '/favicon.png',
  type = 'website',
  noindex = false,
  jsonld = null,
} = Astro.props;
// Google cuts descriptions around 155-160 chars; trim long ones at a word boundary.
const desc = description.length > 158 ? description.slice(0, 155).replace(/\s+\S*$/, '').replace(/[,;:.\s]+$/, '') + '...' : description;
// Self-referencing canonical from the real page URL (site is set in astro.config); an explicit url prop wins.
const canonical = url !== 'https://allemanit.com/' ? url : new URL(Astro.url.pathname, Astro.site).href;
const imageAbs = image.startsWith('http') ? image : new URL(image, Astro.site).href;
const siteLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Person', '@id': 'https://allemanit.com/#dustin', name: 'Dustin Alleman', url: 'https://allemanit.com/', jobTitle: 'Network Engineer', image: 'https://allemanit.com/me.jpg',
      sameAs: ['https://github.com/almnjoy','https://www.linkedin.com/in/dustin-alleman/','https://www.youtube.com/@Almnjoy','https://www.instagram.com/alleman_joyy/'] },
    { '@type': 'Organization', '@id': 'https://allemanit.com/#org', name: 'AllemanIT', url: 'https://allemanit.com/', logo: 'https://allemanit.com/logo-mark.png', founder: { '@id': 'https://allemanit.com/#dustin' } },
    { '@type': 'WebSite', '@id': 'https://allemanit.com/#site', url: 'https://allemanit.com/', name: 'AllemanIT', publisher: { '@id': 'https://allemanit.com/#org' } },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={favicon} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content="AllemanIT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={imageAbs} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={imageAbs} />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <slot name="head" />
  <!-- Umami analytics -->
  <script defer src="https://analytics.allemanit.com/s.js" data-website-id="40131f77-fb96-4b3d-8887-0ea909102c9a"></script>
  <script defer src="https://analytics.allemanit.com/r.js" data-website-id="40131f77-fb96-4b3d-8887-0ea909102c9a"></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1"><slot /></main>
    <Footer />
  </body>
</html>
