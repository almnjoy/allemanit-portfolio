---
// /comic — a standalone comic-styled reader. Intentionally does NOT use the site
// Base/Nav/Footer: this page wears the comic's look, not the website's.
// Zero-maintenance: drop a page named M-D-YY.png (e.g. 7-25-26.png) into
// public/Comic/ and push. This reads that folder at build, parses the date from
// the filename, numbers the days, and opens on the newest.
import fs from 'node:fs';

function parseDate(name) {
  const base = name.replace(/\.[^.]+$/, '');
  const m = base.match(/^(\d{1,2})[-_.](\d{1,2})[-_.](\d{2,4})/);
  if (!m) return null;
  let [, mo, d, y] = m;
  y = Number(y); if (y < 100) y += 2000;
  const dt = new Date(y, Number(mo) - 1, Number(d));
  return isNaN(dt.valueOf()) ? null : dt;
}

let files = [];
try {
  files = fs.readdirSync('public/Comic').filter((f) => /\.(png|jpe?g|webp|gif)$/i.test(f));
} catch (e) { files = []; }

// chronological, earliest = Day 1
const entries = files
  .map((f) => ({ file: f, date: parseDate(f) }))
  .sort((a, b) => {
    if (a.date && b.date) return a.date.valueOf() - b.date.valueOf();
    return a.file.localeCompare(b.file);
  })
  .map((e, i) => ({
    src: '/Comic/' + encodeURIComponent(e.file),
    day: i + 1,
    label: e.date
      ? e.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
      : e.file,
  }));

const start = entries.length ? entries.length - 1 : 0; // open on newest
const startEntry = entries[start];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>The Daily Log — a comic about my life · Dustin Alleman</title>
    <meta name="description" content="A comic about my life, one page a day. By Dustin Alleman." />
    <meta property="og:title" content="The Daily Log — a comic about my life" />
    <meta property="og:description" content="One page a day. By Dustin Alleman." />
    <meta property="og:type" content="website" />
    {startEntry && (<meta property="og:image" content={`https://allemanit.com${startEntry.src}`} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Patrick+Hand&family=Caveat:wght@600;700&display=swap" rel="stylesheet" />
    <script defer src="https://analytics.allemanit.com/s.js" data-website-id="40131f77-fb96-4b3d-8887-0ea909102c9a"></script>
  </head>
  <body>
    <main class="cx">
      <a class="cx-back" href="/">← allemanit.com</a>

      <header class="cx-mast">
        <span class="cx-kicker">AllemanIT presents</span>
        <h1 class="cx-title">THE DAILY LOG</h1>
        <p class="cx-sub">a comic about my life <span class="cx-heart">♥</span> one page a day</p>
      </header>

      {entries.length === 0 && (
        <div class="cx-empty">
          <div class="cx-empty-box">First page drops soon. Check back <b>today</b>.</div>
        </div>
      )}

      {entries.length > 0 && (
        <section class="cx-reader" id="reader">
          <div class="cx-stage">
            <button class="cx-arrow cx-prev" id="prev" aria-label="Previous day">←</button>
            <figure class="cx-frame">
              <img id="page" src={startEntry.src} alt={`Comic — Day ${startEntry.day}, ${startEntry.label}`} />
            </figure>
            <button class="cx-arrow cx-next" id="next" aria-label="Next day">→</button>
          </div>

          <div class="cx-meta">
            <span class="cx-day" id="dayLabel">{`Day ${startEntry.day}`}</span>
            <span class="cx-dot-sep">·</span>
            <span class="cx-date" id="dateLabel">{startEntry.label}</span>
          </div>

          <div class="cx-dots" id="dots">
            {entries.map((e, i) => (
              <button class:list={["cx-pdot", { on: i === start }]} data-i={i} aria-label={`Day ${e.day}`}></button>
            ))}
          </div>

          <div class="cx-strip">
            {entries.map((e, i) => (
              <button class:list={["cx-thumb", { on: i === start }]} data-i={i} title={`Day ${e.day} · ${e.label}`}>
                <img src={e.src} alt={`Day ${e.day}`} loading="lazy" />
                <span>Day {e.day}</span>
              </button>
            ))}
          </div>
        </section>
      )}

      <footer class="cx-foot">
        <svg class="cx-skate" viewBox="0 0 64 40" width="52" height="34" aria-hidden="true">
          <path d="M8 26 h30 a6 6 0 0 1 6 6 v0 h-42 a6 6 0 0 1 6 -6z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
          <path d="M12 20 v6 M18 18 v8 M24 19 v7 M30 20 v6 M36 22 v4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
          <circle cx="14" cy="36" r="3" fill="none" stroke="currentColor" stroke-width="2.2"/>
          <circle cx="24" cy="36" r="3" fill="none" stroke="currentColor" stroke-width="2.2"/>
          <circle cx="34" cy="36" r="3" fill="none" stroke="currentColor" stroke-width="2.2"/>
          <path d="M50 16 l7 -3 M50 22 l8 -1 M50 28 l7 2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
        <span class="cx-foot-txt">Drawn one page at a time <span class="cx-heart">♥</span> <a href="/">back to the site</a></span>
      </footer>
    </main>

    <script is:inline define:vars={{ entries, start }}>
      (function () {
        if (!entries || !entries.length) return;
        let i = start;
        const img = document.getElementById('page');
        const dayLabel = document.getElementById('dayLabel');
        const dateLabel = document.getElementById('dateLabel');
        const prev = document.getElementById('prev');
        const next = document.getElementById('next');
        const dots = Array.from(document.querySelectorAll('.cx-pdot'));
        const thumbs = Array.from(document.querySelectorAll('.cx-thumb'));

        function render() {
          const e = entries[i];
          if (img.getAttribute('src') !== e.src) {
            img.classList.add('swap');
            img.src = e.src;
            img.alt = 'Comic — Day ' + e.day + ', ' + e.label;
            requestAnimationFrame(() => requestAnimationFrame(() => img.classList.remove('swap')));
          }
          dayLabel.textContent = 'Day ' + e.day;
          dateLabel.textContent = e.label;
          prev.disabled = i <= 0;
          next.disabled = i >= entries.length - 1;
          dots.forEach((d, k) => d.classList.toggle('on', k === i));
          thumbs.forEach((t, k) => t.classList.toggle('on', k === i));
          const on = thumbs[i];
          if (on && on.scrollIntoView) on.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
        }
        function go(n) { i = Math.max(0, Math.min(entries.length - 1, n)); render(); }

        prev.addEventListener('click', () => go(i - 1));
        next.addEventListener('click', () => go(i + 1));
        dots.forEach((d) => d.addEventListener('click', () => go(+d.dataset.i)));
        thumbs.forEach((t) => t.addEventListener('click', () => go(+t.dataset.i)));
        document.addEventListener('keydown', (ev) => {
          if (ev.key === 'ArrowLeft') go(i - 1);
          else if (ev.key === 'ArrowRight') go(i + 1);
        });
        render();
      })();
    </script>

    <style>
      :root {
        --paper:#efe7d6; --paper2:#e7ddc8; --ink:#1f2b3a; --ink2:#33404f;
        --line:#141821; --accent:#c65b6b; --note:#e9cf6a;
      }
      * { box-sizing:border-box; }
      html, body { margin:0; }
      body {
        background:
          radial-gradient(120% 90% at 50% 0%, #f4eddf 0%, var(--paper) 42%, var(--paper2) 100%) fixed,
          var(--paper);
        color:var(--ink);
        font-family:'Patrick Hand', ui-rounded, 'Comic Sans MS', cursive;
        min-height:100vh;
      }
      body::before {
        content:""; position:fixed; inset:0; pointer-events:none; z-index:0;
        box-shadow:inset 0 0 220px rgba(60,45,25,0.28);
        background:radial-gradient(140% 120% at 50% 40%, transparent 60%, rgba(70,52,28,0.10) 100%);
      }
      .cx { position:relative; z-index:1; max-width:1120px; margin:0 auto; padding:18px 20px 60px; }

      .cx-back {
        display:inline-block; font-family:'Patrick Hand',cursive; font-size:16px;
        color:var(--ink2); text-decoration:none; opacity:.75; padding:6px 2px;
      }
      .cx-back:hover { opacity:1; color:var(--accent); }

      .cx-mast { text-align:center; padding:6px 0 14px; }
      .cx-kicker {
        font-family:'Caveat',cursive; font-weight:700; font-size:22px; color:var(--accent);
        display:block; transform:rotate(-2deg);
      }
      .cx-title {
        font-family:'Bangers', system-ui, cursive; font-weight:400;
        font-size:clamp(46px,10vw,104px); line-height:.9; letter-spacing:2px;
        color:var(--ink); margin:2px 0 4px; text-shadow:3px 3px 0 rgba(20,24,33,0.12);
      }
      .cx-sub { font-family:'Patrick Hand',cursive; font-size:clamp(16px,2.4vw,22px); color:var(--ink2); margin:0; }
      .cx-heart { color:var(--accent); }

      .cx-reader { margin-top:8px; }
      .cx-stage { display:flex; align-items:center; justify-content:center; gap:14px; }

      .cx-frame {
        margin:0; background:#fbf7ee; padding:10px; border:3px solid var(--line);
        border-radius:16px; box-shadow:6px 8px 0 rgba(20,24,33,0.18), 0 2px 0 rgba(20,24,33,0.9);
        max-width:900px; width:100%;
      }
      .cx-frame img {
        display:block; width:100%; height:auto; max-height:80vh; object-fit:contain;
        border-radius:8px; transition:opacity .18s ease; background:#fbf7ee;
      }
      .cx-frame img.swap { opacity:0; }

      .cx-arrow {
        flex:none; width:52px; height:52px; border-radius:999px; cursor:pointer;
        border:3px solid var(--line); background:var(--ink); color:#fbf7ee;
        font-family:'Bangers',cursive; font-size:26px; line-height:1;
        box-shadow:3px 4px 0 rgba(20,24,33,0.25); transition:transform .08s ease, background .15s ease;
      }
      .cx-arrow:hover:not(:disabled) { background:var(--accent); transform:translateY(-1px); }
      .cx-arrow:active:not(:disabled) { transform:translateY(1px); box-shadow:1px 2px 0 rgba(20,24,33,0.25); }
      .cx-arrow:disabled { opacity:.28; cursor:default; }

      .cx-meta { text-align:center; margin:16px 0 6px; }
      .cx-day { font-family:'Bangers',cursive; font-size:26px; letter-spacing:1px; color:var(--ink); }
      .cx-dot-sep { color:var(--accent); margin:0 8px; }
      .cx-date { font-family:'Patrick Hand',cursive; font-size:19px; color:var(--ink2); }

      .cx-dots { display:flex; flex-wrap:wrap; justify-content:center; gap:9px; margin:10px 0 4px; }
      .cx-pdot {
        width:12px; height:12px; border-radius:999px; padding:0; cursor:pointer;
        border:2px solid var(--line); background:transparent; transition:background .15s ease, transform .1s ease;
      }
      .cx-pdot:hover { transform:scale(1.15); }
      .cx-pdot.on { background:var(--ink); }

      .cx-strip {
        display:flex; gap:10px; overflow-x:auto; padding:18px 4px 8px; margin-top:10px;
        scrollbar-width:thin; justify-content:flex-start;
      }
      .cx-strip:has(.cx-thumb:only-child) { justify-content:center; }
      .cx-thumb {
        flex:none; width:96px; cursor:pointer; background:#fbf7ee; padding:5px 5px 3px;
        border:2.5px solid var(--line); border-radius:10px; box-shadow:2px 3px 0 rgba(20,24,33,0.16);
        transition:transform .1s ease; display:flex; flex-direction:column; gap:3px; align-items:center;
      }
      .cx-thumb:hover { transform:translateY(-2px); }
      .cx-thumb.on { border-color:var(--accent); box-shadow:2px 3px 0 var(--accent); }
      .cx-thumb img { width:100%; height:58px; object-fit:cover; border-radius:5px; display:block; }
      .cx-thumb span { font-family:'Bangers',cursive; font-size:13px; letter-spacing:.5px; color:var(--ink2); }

      .cx-empty { display:flex; justify-content:center; padding:40px 0; }
      .cx-empty-box {
        font-family:'Patrick Hand',cursive; font-size:20px; color:var(--ink2);
        background:#fbf7ee; border:3px solid var(--line); border-radius:14px; padding:22px 28px;
        box-shadow:5px 6px 0 rgba(20,24,33,0.16);
      }

      .cx-foot {
        display:flex; align-items:center; justify-content:center; gap:12px;
        margin-top:34px; padding-top:20px; border-top:2px dashed rgba(20,24,33,0.28);
        color:var(--ink2);
      }
      .cx-skate { color:var(--ink2); }
      .cx-foot-txt { font-family:'Patrick Hand',cursive; font-size:16px; }
      .cx-foot-txt a { color:var(--ink2); text-decoration:underline; text-underline-offset:2px; }
      .cx-foot-txt a:hover { color:var(--accent); }

      @media (max-width:640px) {
        .cx-arrow { width:44px; height:44px; font-size:22px; }
        .cx-stage { gap:8px; }
        .cx-frame { padding:7px; }
      }
    </style>
  </body>
</html>
