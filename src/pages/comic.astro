---
// /comic — standalone comic-styled reader. Wears the comic's look, not the site's.
// Two levels: a table of contents (each folder in public/Comic/ = a chapter) and a
// flip reader per chapter. Zero-maintenance: add a folder = new chapter; drop a page
// named M-DD-YY.png (date chapters) or Name-N.png (flashbacks) and push.
// Later animation phase can swap the still for a GIF per page with no structural change.
import fs from 'node:fs';

const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];

function parseDate(stem) {
  const m = stem.match(/^(\d{1,2})[-_.](\d{1,2})[-_.](\d{2,4})/);
  if (!m) return null;
  let [, mo, d, y] = m; y = Number(y); if (y < 100) y += 2000;
  const dt = new Date(y, Number(mo) - 1, Number(d));
  return isNaN(dt.valueOf()) ? null : dt;
}
function fmtDate(dt) {
  return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
function prettyChapter(name) {
  const m = name.match(/^(\d{1,2})[-_.](\d{2,4})$/); // M-YY or MM-YYYY
  if (m) {
    let mo = Number(m[1]), y = Number(m[2]); if (y < 100) y += 2000;
    if (mo >= 1 && mo <= 12) return `${MONTHS[mo - 1]} ${y}`;
  }
  if (/flash\s*back/i.test(name)) return 'Flashbacks';
  return name.replace(/[-_]+/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}
function chapterDateKey(name) {
  const m = name.match(/^(\d{1,2})[-_.](\d{2,4})$/);
  if (!m) return null;
  let mo = Number(m[1]), y = Number(m[2]); if (y < 100) y += 2000;
  return y * 100 + mo;
}

const ROOT = 'public/Comic';
let chapters = [];
try {
  const dirs = fs.readdirSync(ROOT, { withFileTypes: true }).filter((d) => d.isDirectory());
  chapters = dirs.map((d) => {
    let files = [];
    try { files = fs.readdirSync(`${ROOT}/${d.name}`).filter((f) => /\.(png|jpe?g|webp|gif)$/i.test(f)); } catch (e) {}
    const pages = files
      .map((f) => {
        const stem = f.replace(/\.[^.]+$/, '');
        const date = parseDate(stem);
        const nm = stem.match(/(\d+)\s*$/);
        return { file: f, date, num: nm ? Number(nm[1]) : null };
      })
      .sort((a, b) => {
        if (a.date && b.date) return a.date.valueOf() - b.date.valueOf();
        if (a.num != null && b.num != null) return a.num - b.num;
        return a.file.localeCompare(b.file);
      })
      .map((p, i) => ({
        src: `/Comic/${encodeURIComponent(d.name)}/${encodeURIComponent(p.file)}`,
        n: i + 1,
        label: p.date ? fmtDate(p.date) : p.file.replace(/\.[^.]+$/, ''),
      }));
    const isFlash = /flash/i.test(d.name);
    return {
      slug: d.name,
      name: prettyChapter(d.name),
      unit: isFlash ? 'Flashback' : 'Day',
      dateKey: chapterDateKey(d.name),
      pages,
    };
  }).filter((c) => c.pages.length > 0);
} catch (e) { chapters = []; }

// date chapters newest-first, then non-date chapters (Flashbacks) after
chapters.sort((a, b) => {
  if (a.dateKey && b.dateKey) return b.dateKey - a.dateKey;
  if (a.dateKey && !b.dateKey) return -1;
  if (!a.dateKey && b.dateKey) return 1;
  return a.name.localeCompare(b.name);
});

// compact data for the client
const CH = {};
chapters.forEach((c) => {
  CH[c.slug] = { unit: c.unit, srcs: c.pages.map((p) => p.src), labels: c.pages.map((p) => p.label) };
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>The Daily Log — a comic about my life · Dustin Alleman</title>
    <meta name="description" content="A comic about my life, one page a day. By Dustin Alleman." />
    <meta property="og:title" content="The Daily Log — a comic about my life" />
    <meta property="og:description" content="One page a day. By Dustin Alleman." />
    <meta property="og:type" content="website" />
    {chapters[0]?.pages[0] && (<meta property="og:image" content={`https://allemanit.com${chapters[0].pages[0].src}`} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Patrick+Hand&family=Caveat:wght@600;700&display=swap" rel="stylesheet" />
    <script defer src="https://analytics.allemanit.com/s.js" data-website-id="40131f77-fb96-4b3d-8887-0ea909102c9a"></script>
  </head>
  <body>
    <main class="cx">
      <a class="cx-back" href="/">← allemanit.com</a>

      <header class="cx-mast">
        <span class="cx-kicker">AllemanIT presents</span>
        <h1 class="cx-title">THE DAILY LOG</h1>
        <p class="cx-sub">a comic about my life <span class="cx-heart">♥</span> one page a day</p>
      </header>

      {chapters.length === 0 && (
        <div class="cx-empty"><div class="cx-empty-box">First chapter drops soon. Check back <b>today</b>.</div></div>
      )}

      {chapters.length > 0 && (
        <section class="cx-toc" id="toc">
          <div class="cx-toc-head">Chapters</div>
          <div class="cx-toc-grid">
            {chapters.map((c) => (
              <a class="cx-ch-card" href={`#${c.slug}`} data-slug={c.slug}>
                <div class="cx-ch-cover"><img src={c.pages[0].src} alt={c.name} loading="lazy" /></div>
                <div class="cx-ch-meta">
                  <span class="cx-ch-name">{c.name}</span>
                  <span class="cx-ch-count">{c.pages.length} {c.pages.length === 1 ? 'page' : 'pages'}</span>
                </div>
                <span class="cx-ch-go">Read →</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {chapters.map((c) => (
        <section class="cx-chapter" id={`ch-${c.slug}`} data-slug={c.slug} hidden>
          <div class="cx-chbar">
            <a class="cx-tocback" href="#">← All chapters</a>
            <span class="cx-chtitle">{c.name}</span>
          </div>

          <div class="cx-stage">
            <button class="cx-arrow cx-prev" data-slug={c.slug} data-dir="-1" aria-label="Previous page">←</button>
            <figure class="cx-frame">
              <img class="cx-page" data-slug={c.slug} src={c.pages[0].src} alt={`${c.name} — ${c.unit} 1, ${c.pages[0].label}`} />
              <span class="cx-zoomhint" aria-hidden="true">⤢ tap to zoom</span>
            </figure>
            <button class="cx-arrow cx-next" data-slug={c.slug} data-dir="1" aria-label="Next page">→</button>
          </div>

          <div class="cx-meta">
            <span class="cx-day" data-role="unit">{`${c.unit} 1`}</span>
            <span class="cx-dot-sep">·</span>
            <span class="cx-date" data-role="date">{c.pages[0].label}</span>
          </div>

          <div class="cx-dots">
            {c.pages.map((p, i) => (
              <button class:list={["cx-pdot", { on: i === 0 }]} data-slug={c.slug} data-i={i} aria-label={`${c.unit} ${p.n}`}></button>
            ))}
          </div>

          <div class="cx-strip">
            {c.pages.map((p, i) => (
              <button class:list={["cx-thumb", { on: i === 0 }]} data-slug={c.slug} data-i={i} title={`${c.unit} ${p.n} · ${p.label}`}>
                <img src={p.src} alt={`${c.unit} ${p.n}`} loading="lazy" />
                <span>{c.unit} {p.n}</span>
              </button>
            ))}
          </div>
        </section>
      ))}

      <footer class="cx-foot">
        <svg class="cx-skate" viewBox="0 0 64 40" width="52" height="34" aria-hidden="true">
          <path d="M8 26 h30 a6 6 0 0 1 6 6 v0 h-42 a6 6 0 0 1 6 -6z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
          <path d="M12 20 v6 M18 18 v8 M24 19 v7 M30 20 v6 M36 22 v4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
          <circle cx="14" cy="36" r="3" fill="none" stroke="currentColor" stroke-width="2.2"/>
          <circle cx="24" cy="36" r="3" fill="none" stroke="currentColor" stroke-width="2.2"/>
          <circle cx="34" cy="36" r="3" fill="none" stroke="currentColor" stroke-width="2.2"/>
          <path d="M50 16 l7 -3 M50 22 l8 -1 M50 28 l7 2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
        <span class="cx-foot-txt">Drawn one page at a time <span class="cx-heart">♥</span> <a href="/">back to the site</a></span>
      </footer>
    </main>

    <div class="cx-lb" id="lightbox" hidden>
      <button class="cx-lb-close" id="lbClose" aria-label="Close">✕</button>
      <div class="cx-lb-scroll" id="lbScroll"><img id="lbImg" src="" alt="" /></div>
      <div class="cx-lb-hint" id="lbHint">tap image to zoom · drag to pan</div>
    </div>

    <script is:inline define:vars={{ CH }}>
      (function () {
        const slugs = Object.keys(CH);
        if (!slugs.length) return;
        const idx = {};
        slugs.forEach((s) => (idx[s] = 0));

        const toc = document.getElementById('toc');
        const chapters = {};
        slugs.forEach((s) => (chapters[s] = document.getElementById('ch-' + s)));

        function renderChapter(s) {
          const data = CH[s], i = idx[s], sec = chapters[s];
          const img = sec.querySelector('.cx-page');
          if (img.getAttribute('src') !== data.srcs[i]) {
            img.classList.add('swap');
            img.src = data.srcs[i];
            img.alt = sec.dataset.slug + ' — ' + data.unit + ' ' + (i + 1) + ', ' + data.labels[i];
            requestAnimationFrame(() => requestAnimationFrame(() => img.classList.remove('swap')));
          }
          sec.querySelector('[data-role="unit"]').textContent = data.unit + ' ' + (i + 1);
          sec.querySelector('[data-role="date"]').textContent = data.labels[i];
          sec.querySelector('.cx-prev').disabled = i <= 0;
          sec.querySelector('.cx-next').disabled = i >= data.srcs.length - 1;
          sec.querySelectorAll('.cx-pdot').forEach((d, k) => d.classList.toggle('on', k === i));
          sec.querySelectorAll('.cx-thumb').forEach((t, k) => {
            const on = k === i; t.classList.toggle('on', on);
            if (on && t.scrollIntoView) t.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
          });
        }
        function go(s, n) {
          idx[s] = Math.max(0, Math.min(CH[s].srcs.length - 1, n));
          renderChapter(s);
        }

        function showTOC() {
          slugs.forEach((s) => (chapters[s].hidden = true));
          if (toc) toc.hidden = false;
          window.scrollTo({ top: 0 });
        }
        function showChapter(s) {
          if (!CH[s]) return showTOC();
          if (toc) toc.hidden = true;
          slugs.forEach((x) => (chapters[x].hidden = x !== s));
          renderChapter(s);
          window.scrollTo({ top: 0 });
        }
        function route() {
          const s = decodeURIComponent(location.hash.replace(/^#/, ''));
          if (s && CH[s]) showChapter(s); else showTOC();
        }

        // per-chapter controls
        slugs.forEach((s) => {
          const sec = chapters[s];
          sec.querySelector('.cx-prev').addEventListener('click', () => go(s, idx[s] - 1));
          sec.querySelector('.cx-next').addEventListener('click', () => go(s, idx[s] + 1));
          sec.querySelectorAll('.cx-pdot').forEach((d) => d.addEventListener('click', () => go(s, +d.dataset.i)));
          sec.querySelectorAll('.cx-thumb').forEach((t) => t.addEventListener('click', () => go(s, +t.dataset.i)));
          const img = sec.querySelector('.cx-page');
          img.addEventListener('click', () => openLB(img.src, img.alt));
          // swipe
          let x0 = null;
          const stage = sec.querySelector('.cx-stage');
          stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
          stage.addEventListener('touchend', (e) => {
            if (x0 == null) return;
            const dx = e.changedTouches[0].clientX - x0;
            if (Math.abs(dx) > 45) go(s, idx[s] + (dx < 0 ? 1 : -1));
            x0 = null;
          }, { passive: true });
        });

        document.addEventListener('keydown', (e) => {
          const s = decodeURIComponent(location.hash.replace(/^#/, ''));
          if (!CH[s]) return;
          if (e.key === 'ArrowLeft') go(s, idx[s] - 1);
          else if (e.key === 'ArrowRight') go(s, idx[s] + 1);
        });

        // lightbox
        const lb = document.getElementById('lightbox');
        const lbImg = document.getElementById('lbImg');
        const lbScroll = document.getElementById('lbScroll');
        function openLB(src, alt) {
          lbImg.src = src; lbImg.alt = alt || '';
          lbImg.classList.remove('zoomed');
          lb.hidden = false; document.body.style.overflow = 'hidden';
        }
        function closeLB() { lb.hidden = true; lbImg.src = ''; document.body.style.overflow = ''; }
        document.getElementById('lbClose').addEventListener('click', closeLB);
        lb.addEventListener('click', (e) => { if (e.target === lb || e.target === lbScroll) closeLB(); });
        lbImg.addEventListener('click', (e) => {
          e.stopPropagation();
          const z = lbImg.classList.toggle('zoomed');
          if (z) {
            const r = lbImg.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width, py = (e.clientY - r.top) / r.height;
            requestAnimationFrame(() => {
              lbScroll.scrollLeft = px * (lbScroll.scrollWidth - lbScroll.clientWidth);
              lbScroll.scrollTop = py * (lbScroll.scrollHeight - lbScroll.clientHeight);
            });
          }
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !lb.hidden) closeLB(); });

        window.addEventListener('hashchange', route);
        route();
      })();
    </script>

    <style is:global>
      :root {
        --paper:#efe7d6; --paper2:#e7ddc8; --ink:#1f2b3a; --ink2:#33404f;
        --line:#141821; --accent:#c65b6b; --note:#e9cf6a;
      }
      * { box-sizing:border-box; }
      html, body { margin:0; }
      body {
        background:
          radial-gradient(120% 90% at 50% 0%, #f4eddf 0%, var(--paper) 42%, var(--paper2) 100%) fixed,
          var(--paper);
        color:var(--ink); min-height:100vh;
        font-family:'Patrick Hand', ui-rounded, 'Comic Sans MS', cursive;
      }
      body::before {
        content:""; position:fixed; inset:0; pointer-events:none; z-index:0;
        box-shadow:inset 0 0 220px rgba(60,45,25,0.28);
        background:radial-gradient(140% 120% at 50% 40%, transparent 60%, rgba(70,52,28,0.10) 100%);
      }
      .cx { position:relative; z-index:1; max-width:1120px; margin:0 auto; padding:16px 18px 60px; }

      .cx-back { display:inline-block; font-family:'Patrick Hand',cursive; font-size:16px; color:var(--ink2); text-decoration:none; opacity:.75; padding:6px 2px; }
      .cx-back:hover { opacity:1; color:var(--accent); }

      .cx-mast { text-align:center; padding:4px 0 12px; }
      .cx-kicker { font-family:'Caveat',cursive; font-weight:700; font-size:22px; color:var(--accent); display:block; transform:rotate(-2deg); }
      .cx-title { font-family:'Bangers', system-ui, cursive; font-weight:400; font-size:clamp(42px,9vw,96px); line-height:.9; letter-spacing:2px; color:var(--ink); margin:2px 0 4px; text-shadow:3px 3px 0 rgba(20,24,33,0.12); }
      .cx-sub { font-family:'Patrick Hand',cursive; font-size:clamp(15px,2.4vw,22px); color:var(--ink2); margin:0; }
      .cx-heart { color:var(--accent); }

      /* table of contents */
      .cx-toc-head { font-family:'Bangers',cursive; font-size:22px; letter-spacing:1px; color:var(--ink2); text-align:center; margin:6px 0 14px; }
      .cx-toc-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(230px, 1fr)); gap:18px; }
      .cx-ch-card {
        display:flex; flex-direction:column; text-decoration:none; color:inherit;
        background:#fbf7ee; border:3px solid var(--line); border-radius:16px; overflow:hidden;
        box-shadow:5px 7px 0 rgba(20,24,33,0.18); transition:transform .1s ease, box-shadow .1s ease;
      }
      .cx-ch-card:hover { transform:translateY(-3px); box-shadow:7px 10px 0 rgba(20,24,33,0.22); }
      .cx-ch-cover { border-bottom:3px solid var(--line); background:#efe7d6; aspect-ratio:4/3; overflow:hidden; }
      .cx-ch-cover img { width:100%; height:100%; object-fit:cover; object-position:top center; display:block; }
      .cx-ch-meta { display:flex; flex-direction:column; gap:1px; padding:10px 14px 2px; }
      .cx-ch-name { font-family:'Bangers',cursive; font-size:26px; letter-spacing:.5px; color:var(--ink); line-height:1; }
      .cx-ch-count { font-family:'Patrick Hand',cursive; font-size:15px; color:var(--ink2); }
      .cx-ch-go { font-family:'Caveat',cursive; font-weight:700; font-size:20px; color:var(--accent); padding:0 14px 12px; align-self:flex-end; }

      /* reader */
      .cx-chbar { display:flex; align-items:center; gap:14px; margin:2px 0 12px; }
      .cx-tocback { font-family:'Patrick Hand',cursive; font-size:16px; color:var(--ink2); text-decoration:none; border:2px solid var(--line); border-radius:999px; padding:4px 12px; background:#fbf7ee; box-shadow:2px 3px 0 rgba(20,24,33,0.16); }
      .cx-tocback:hover { color:var(--accent); }
      .cx-chtitle { font-family:'Bangers',cursive; font-size:26px; letter-spacing:.5px; color:var(--ink); }

      .cx-stage { display:flex; align-items:center; justify-content:center; gap:14px; }
      .cx-frame { position:relative; margin:0; background:#fbf7ee; padding:10px; border:3px solid var(--line); border-radius:16px; box-shadow:6px 8px 0 rgba(20,24,33,0.18), 0 2px 0 rgba(20,24,33,0.9); max-width:900px; width:100%; }
      .cx-page { display:block; width:100%; height:auto; max-height:80vh; object-fit:contain; border-radius:8px; transition:opacity .18s ease; background:#fbf7ee; cursor:zoom-in; }
      .cx-page.swap { opacity:0; }
      .cx-zoomhint { position:absolute; right:16px; bottom:16px; font-family:'Patrick Hand',cursive; font-size:13px; color:#fbf7ee; background:rgba(20,24,33,0.72); border-radius:999px; padding:3px 10px; pointer-events:none; opacity:.9; }

      .cx-arrow { flex:none; width:52px; height:52px; border-radius:999px; cursor:pointer; border:3px solid var(--line); background:var(--ink); color:#fbf7ee; font-family:'Bangers',cursive; font-size:26px; line-height:1; box-shadow:3px 4px 0 rgba(20,24,33,0.25); transition:transform .08s ease, background .15s ease; }
      .cx-arrow:hover:not(:disabled) { background:var(--accent); transform:translateY(-1px); }
      .cx-arrow:active:not(:disabled) { transform:translateY(1px); box-shadow:1px 2px 0 rgba(20,24,33,0.25); }
      .cx-arrow:disabled { opacity:.28; cursor:default; }

      .cx-meta { text-align:center; margin:16px 0 6px; }
      .cx-day { font-family:'Bangers',cursive; font-size:26px; letter-spacing:1px; color:var(--ink); }
      .cx-dot-sep { color:var(--accent); margin:0 8px; }
      .cx-date { font-family:'Patrick Hand',cursive; font-size:19px; color:var(--ink2); }

      .cx-dots { display:flex; flex-wrap:wrap; justify-content:center; gap:9px; margin:10px 0 4px; }
      .cx-pdot { width:12px; height:12px; border-radius:999px; padding:0; cursor:pointer; border:2px solid var(--line); background:transparent; transition:background .15s ease, transform .1s ease; }
      .cx-pdot:hover { transform:scale(1.15); }
      .cx-pdot.on { background:var(--ink); }

      .cx-strip { display:flex; gap:10px; overflow-x:auto; padding:18px 4px 8px; margin-top:10px; scrollbar-width:thin; }
      .cx-thumb { flex:none; width:96px; cursor:pointer; background:#fbf7ee; padding:5px 5px 3px; border:2.5px solid var(--line); border-radius:10px; box-shadow:2px 3px 0 rgba(20,24,33,0.16); transition:transform .1s ease; display:flex; flex-direction:column; gap:3px; align-items:center; }
      .cx-thumb:hover { transform:translateY(-2px); }
      .cx-thumb.on { border-color:var(--accent); box-shadow:2px 3px 0 var(--accent); }
      .cx-thumb img { width:100%; height:58px; object-fit:cover; object-position:top center; border-radius:5px; display:block; }
      .cx-thumb span { font-family:'Bangers',cursive; font-size:13px; letter-spacing:.5px; color:var(--ink2); white-space:nowrap; }

      .cx-empty { display:flex; justify-content:center; padding:40px 0; }
      .cx-empty-box { font-family:'Patrick Hand',cursive; font-size:20px; color:var(--ink2); background:#fbf7ee; border:3px solid var(--line); border-radius:14px; padding:22px 28px; box-shadow:5px 6px 0 rgba(20,24,33,0.16); }

      .cx-foot { display:flex; align-items:center; justify-content:center; gap:12px; margin-top:34px; padding-top:20px; border-top:2px dashed rgba(20,24,33,0.28); color:var(--ink2); }
      .cx-skate { color:var(--ink2); }
      .cx-foot-txt { font-family:'Patrick Hand',cursive; font-size:16px; }
      .cx-foot-txt a { color:var(--ink2); text-decoration:underline; text-underline-offset:2px; }
      .cx-foot-txt a:hover { color:var(--accent); }

      /* lightbox */
      .cx-lb { position:fixed; inset:0; z-index:50; background:rgba(18,15,10,0.92); display:flex; align-items:center; justify-content:center; }
      .cx-lb[hidden] { display:none; }
      .cx-lb-scroll { max-width:100vw; max-height:100vh; width:100%; height:100%; overflow:auto; display:flex; align-items:flex-start; justify-content:center; -webkit-overflow-scrolling:touch; }
      .cx-lb-scroll img { display:block; max-width:100%; max-height:100vh; width:auto; height:auto; object-fit:contain; margin:auto; cursor:zoom-in; }
      .cx-lb-scroll img.zoomed { max-width:none; max-height:none; width:auto; cursor:zoom-out; }
      .cx-lb-close { position:fixed; top:14px; right:16px; z-index:52; width:44px; height:44px; border-radius:999px; border:2px solid #fbf7ee; background:rgba(20,24,33,0.7); color:#fbf7ee; font-size:20px; cursor:pointer; font-family:'Bangers',cursive; }
      .cx-lb-close:hover { background:var(--accent); }
      .cx-lb-hint { position:fixed; bottom:14px; left:50%; transform:translateX(-50%); z-index:52; font-family:'Patrick Hand',cursive; font-size:14px; color:#fbf7ee; background:rgba(20,24,33,0.6); border-radius:999px; padding:4px 12px; }

      @media (max-width:640px) {
