---
import Base from '../layouts/Base.astro';
import { production, clients, counts } from '../data/design-lab';

const latest = [...clients, ...production].slice(0, 4);
const doors = [
  { href: '/design-lab/sites/', img: 'quickit-v2', eyebrow: `${counts.sites} sites`, title: 'What shipped', blurb: 'Production, client, family and personal builds, grouped and filterable by stack.' },
  { href: '/design-lab/style-engine/', img: 'style-engine', eyebrow: `${counts.skins} skins`, title: 'The style engine', blurb: 'One markup tree, thirty-two named styles, a dark mode switch. Arrow keys cycle. Two themes are my real brands.' },
  { href: '/design-lab/process/', img: 'quickit-c02', eyebrow: 'Process', title: 'The design process', blurb: 'How I got here, how I build a brand guide, and the parts I stopped rebuilding. Plus the versions that lost.' },
  { href: '/design-lab/opus/', img: 'opusdiecast-vault', eyebrow: 'Featured project', title: 'Opus\'s Diecast Emporium', blurb: 'A public catalogue with a private vault behind it. Cars get in by filming the shelf.' },
];
---
<Base
  title="Design Lab | AllemanIT"
  description="Every project I build needs a front end. The Design Lab is where the versions live: the sites that shipped, the rejects, the style engine, and how it all gets made."
  url="https://allemanit.com/design-lab/"
>
  <Fragment slot="head"><link rel="canonical" href="https://allemanit.com/design-lab/" /></Fragment>

  <section class="container-x pt-14 pb-8">
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-brand-orange">AllemanIT / Design Lab</p>
    <h1 class="text-4xl font-extrabold text-white sm:text-5xl">Every project needed a front end.<br class="hidden sm:block" /> So I got good at making them.</h1>
    <p class="mt-5 max-w-3xl text-lg text-white/70">Homelab services, AI apps, a consulting business, family stuff, a dad with a wall of Hot Wheels. All of it eventually needed a page, a portal, a dashboard, or a catalogue. This is where the versions live.</p>
    <div class="mt-7 flex flex-wrap gap-x-8 gap-y-3 text-sm">
      <div><span class="text-2xl font-extrabold text-white">{counts.sites}</span> <span class="text-white/60">sites shipped</span></div>
      <div><span class="text-2xl font-extrabold text-white">{counts.versions}</span> <span class="text-white/60">versions rejected</span></div>
      <div><span class="text-2xl font-extrabold text-white">{counts.skins}</span> <span class="text-white/60">skins in the engine</span></div>
      <div><span class="text-2xl font-extrabold text-white">1</span> <span class="text-white/60">token file per brand</span></div>
    </div>
  </section>

  <!-- DOORS -->
  <section class="container-x py-8">
    <div class="grid gap-5 sm:grid-cols-2">
      {doors.map((d) => (
        <a href={d.href} class="card group block overflow-hidden">
          <img src={`/design-lab/shots/${d.img}.jpg`} alt={d.title} loading="lazy" decoding="async" width="1440" height="900" class="aspect-[16/9] w-full object-cover object-top transition group-hover:scale-[1.01]" />
          <div class="p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-orange">{d.eyebrow}</p>
            <h2 class="mt-1.5 text-2xl font-bold text-white">{d.title}</h2>
            <p class="mt-2 text-white/65">{d.blurb}</p>
            <span class="mt-4 inline-block font-semibold text-brand-orange group-hover:underline underline-offset-4">Open →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- LATEST STRIP -->
  <section class="container-x py-10">
    <div class="flex items-end justify-between gap-3">
      <div>
        <h2 class="text-2xl font-bold text-white">Recently shipped</h2>
        <p class="mt-1 text-white/60">The newest four. The whole list is one click over.</p>
      </div>
      <a href="/design-lab/sites/" class="hidden text-sm font-semibold text-brand-orange hover:underline underline-offset-4 sm:inline">All {counts.sites} sites →</a>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {latest.map((s) => (
        <a href={s.story ?? s.url} {...(!s.story && s.url.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})} class="card group block overflow-hidden">
          <img src={`/design-lab/shots/${s.img}.jpg`} alt={s.title} loading="lazy" decoding="async" width="1440" height="900" class="aspect-[16/10] w-full object-cover object-top" />
          <div class="p-4"><div class="flex items-center justify-between gap-2"><span class="truncate font-bold text-white">{s.title}</span><span class="tag shrink-0">{s.stack}</span></div></div>
        </a>
      ))}
    </div>
    <a href="/design-lab/sites/" class="mt-4 inline-block text-sm font-semibold text-brand-orange hover:underline underline-offset-4 sm:hidden">All {counts.sites} sites →</a>
  </section>

  <section class="container-x py-10">
    <div class="card flex flex-col items-start justify-between gap-4 p-6 sm:flex-row sm:items-center">
      <div>
        <h2 class="text-xl font-bold text-white">Need one of these for your business?</h2>
        <p class="mt-1 text-sm text-white/60">That is the Quick IT side of the house. Free 30-minute consult, you talk to the person who builds it.</p>
      </div>
      <a href="https://quickitprojects.com/start" target="_blank" rel="noopener" data-umami-event="outbound-click" data-umami-event-site="allemanit" data-umami-event-destination="quickit" data-umami-event-placement="design-lab-cta" class="btn btn-primary text-sm">Start a project</a>
    </div>
  </section>
</Base>
