---
import Base from '../layouts/Base.astro';
// Short, memorable pointer at the Skate NYC 2026 hub. The hub moved to its own home
// on skate-map.com (2026-08-04; the old madeformeai.com/skatenyc 301s there too).
// This page exists so "allemanit.com/skate" is a thing you can say out loud in a
// hotel lobby. Safe to delete whenever.
const HUB = 'https://skate-map.com/skatenyc';
---
<Base
  title="Big Apple Roll 2026 — the crew hub"
  description="Schedule, live map, photo wall, check-ins and a bot that answers anything about BAR 2026. English, Spanish, Portuguese. No login."
  image="https://allemanit.com/skate/social.png"
  url="https://allemanit.com/skate"
  favicon="/skate/favicon.svg">
  <section class="container-x py-14">
    <div class="mx-auto max-w-3xl">

      <div class="text-center">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-orange">July 30 – August 2 · NYC</p>
        <h1 class="mt-2 text-4xl font-extrabold text-white sm:text-5xl">Big Apple Roll <span class="text-brand-orange">2026</span></h1>
        <p class="mx-auto mt-4 max-w-xl text-white/70">
          A hub for keeping track of each other all weekend. Full schedule, a live map, a photo wall,
          who's out right now, and a bot that answers in whatever language you type.
          No app, no login.
        </p>
      </div>

      <div class="mt-9 flex flex-col items-center gap-6 rounded-2xl border border-brand-orange/30 bg-gradient-to-br from-brand-orange/10 to-transparent p-7 sm:flex-row sm:items-center">
        <div class="flex-none rounded-xl bg-white p-3">
          <img src="/skate/qr.png" alt="QR code to the Big Apple Roll 2026 hub" width="160" height="160" class="h-40 w-40" />
        </div>
        <div class="min-w-0 flex-1 text-center sm:text-left">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-white/50">Point a camera at it</p>
          <p class="mt-1 break-all text-xl font-extrabold text-white sm:text-2xl">skate-map.com/skatenyc</p>
          <a href={HUB} class="btn btn-primary mt-5 w-full text-base sm:w-auto">Open the hub →</a>
        </div>
      </div>

      <div class="mt-10">
        <h2 class="text-2xl font-extrabold text-white">What's in it</h2>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          <div class="card p-4"><b class="text-white">🗓 The whole schedule</b><p class="mt-1 text-sm text-white/60">Every skate, workshop and party, day by day, with how hard each route is and how far.</p></div>
          <div class="card p-4"><b class="text-white">📍 Live map</b><p class="mt-1 text-sm text-white/60">Meetups, food, the hotel. One tap for Google or Apple Maps. Anyone can drop their own pin.</p></div>
          <div class="card p-4"><b class="text-white">🙋 Who's out right now</b><p class="mt-1 text-sm text-white/60">One tap to check in. Shows the crew that's rolling, clears itself after 90 minutes.</p></div>
          <div class="card p-4"><b class="text-white">📷 Photo wall</b><p class="mt-1 text-sm text-white/60">Straight from your camera. Location data is stripped before anything is stored.</p></div>
          <div class="card p-4"><b class="text-white">🤖 The BAR bot</b><p class="mt-1 text-sm text-white/60">Knows the schedule cold, plus Midtown. Ask in Spanish or Portuguese and it answers the same way.</p></div>
          <div class="card p-4"><b class="text-white">🌧 Weather + rain radar</b><p class="mt-1 text-sm text-white/60">Hourly through the skate windows, and a heads-up when rain is about 20 minutes out.</p></div>
        </div>
      </div>

      <div class="mt-10 rounded-2xl border border-white/10 p-7">
        <h2 class="text-2xl font-extrabold text-white">Printable posters</h2>
        <p class="mt-2 text-white/60">US Letter. Tape one at the meetup spot and one in the hotel lobby.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/skate/poster-scan.png" download class="btn btn-ghost">Poster: Scan me</a>
          <a href="/skate/poster-crew.png" download class="btn btn-ghost">Poster: Who's out?</a>
        </div>
      </div>

      <p class="mt-10 text-center text-sm text-white/40">
        A community page for skaters. Not the official Big Apple Roll site —
        that's <a href="https://bigappleroll.org" target="_blank" rel="noopener" class="text-brand-orange hover:underline">bigappleroll.org</a>.
      </p>

    </div>
  </section>
</Base>
