---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Style Engine | Design Lab | AllemanIT"
  description="One page, 32 named design styles on real brand tokens. Pick a style, flip dark mode, copy the theme block."
  url="https://allemanit.com/design-lab/style-engine/"
>
  <Fragment slot="head"><link rel="canonical" href="https://allemanit.com/design-lab/style-engine/" /></Fragment>
  <section class="container-x pt-8 pb-4">
    <a href="/design-lab/" class="text-sm text-white/60 hover:text-white">← Design Lab</a>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="text-3xl font-extrabold text-white">Style engine</h1>
        <p class="mt-1 text-white/60">Same markup, 32 skins. Arrow keys cycle. The two brand themes are the real QuickIT and MadeForMeAI tokens.</p>
      </div>
      <a href="/design-lab/engine.html" target="_blank" rel="noopener" class="btn btn-ghost text-sm">Open full screen ↗</a>
    </div>
  </section>
  <section class="container-x pb-12">
    <div class="overflow-hidden rounded-2xl border border-white/10 bg-white">
      <iframe src="/design-lab/engine.html" title="AllemanIT style engine" loading="lazy" class="block w-full" style="height: min(88vh, 1100px); border: 0;"></iframe>
    </div>
  </section>
</Base>
