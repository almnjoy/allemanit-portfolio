---
import Base from '../layouts/Base.astro';
import { products } from '../data/marketplace';
// Contact router (2026-10-08). Four doors: plugin support (form), Quick IT (external), MadeForMeAI (external),
// Plex (the /status page, linked quietly at the bottom). The form posts topic + product so n8n can tag the
// Twenty person with the right platform and route plugin support without a human flipping fields.
// Deep links: /contact/?topic=plugin&product=range-finder-companion preselects the dropdowns.
const CONTACT_WEBHOOK = 'https://n8n.quickitprojects.com/webhook/contact';
const MFM_URL = 'https://madeformeai.com/';
const QUICKIT_URL = 'https://quickitprojects.com/';
const live = products.filter((p) => p.status === 'live').map((p) => ({ slug: p.slug, title: p.title }));
const topics = [
  { value: 'other', label: 'Just reaching out' },
  { value: 'plugin', label: 'Stream Deck plugin or icon set (Elgato Marketplace)' },
  { value: 'quickit', label: 'Quick IT: networking, IT, automation work' },
  { value: 'mfm', label: 'MadeForMeAI account or product' },
];
---
<Base title="Contact Dustin Alleman | AllemanIT" description="Reach Dustin Alleman. Stream Deck plugin support for ALMNJOY products on the Elgato Marketplace, Quick IT Projects work, MadeForMeAI, or just say hi. Every message lands in my inbox.">
  <section class="container-x py-14">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-3xl font-extrabold text-white sm:text-4xl">Get in touch.</h1>
      <p class="mt-2 text-white/65">Pick the door that fits. No funnel, no bot. Messages land in my inbox (<span class="text-white/80">duallema@quickitprojects.com</span>) and I read every one.</p>

      <!-- DOORS -->
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <a href="#form" data-topic="plugin" class="door card p-5 hover:border-brand-orange/50" data-umami-event="contact-door" data-umami-event-site="allemanit" data-umami-event-door="plugin">
          <div class="text-2xl" aria-hidden="true">🎛️</div>
          <div class="mt-2 font-bold text-white">Plugin or icon set support</div>
          <p class="mt-1 text-sm text-white/60">Bought something of mine on the Elgato Marketplace? This is the place. Tell me the product and what's wrong.</p>
          <span class="mt-3 inline-block text-sm font-semibold text-brand-orange">Open the form ↓</span>
        </a>
        <a href={QUICKIT_URL} target="_blank" rel="noopener" class="card p-5 hover:border-brand-orange/50" data-umami-event="outbound-click" data-umami-event-site="allemanit" data-umami-event-destination="quickitprojects" data-umami-event-placement="contact-door">
          <div class="text-2xl" aria-hidden="true">🖧</div>
          <div class="mt-2 font-bold text-white">Work with me · Quick IT</div>
          <p class="mt-1 text-sm text-white/60">Networking, IT, infrastructure, automation. Quotes, projects and the AI line live on the Quick IT site.</p>
          <span class="mt-3 inline-block text-sm font-semibold text-brand-orange">quickitprojects.com ↗</span>
        </a>
        <a href={MFM_URL} target="_blank" rel="noopener" class="card p-5 hover:border-brand-orange/50" data-umami-event="outbound-click" data-umami-event-site="allemanit" data-umami-event-destination="madeformeai" data-umami-event-placement="contact-door">
          <div class="text-2xl" aria-hidden="true">✨</div>
          <div class="mt-2 font-bold text-white">Try your own AI</div>
          <p class="mt-1 text-sm text-white/60">MadeForMeAI. Free account, live demo in minutes, no card. Account questions go through that site too.</p>
          <span class="mt-3 inline-block text-sm font-semibold text-brand-orange">madeformeai.com ↗</span>
        </a>
      </div>

      <!-- FORM: wire-line tile, same language as /daily -->
      <div id="form" class="mt-10 scroll-mt-24">
        <form id="contact-form" class="cf-tile" data-webhook={CONTACT_WEBHOOK} onfocusin="if(!window.__aitFS){window.__aitFS=1;window.umami&&window.umami.track('form-start',{site:'allemanit',form:'contact'})}">
          <div class="cf-head">
            <span class="cf-k">Send me a message</span>
            <span class="cf-live">● lands in my inbox</span>
          </div>

          <div class="cf-row cf-2">
            <label class="cf-field"><span class="cf-k">Name</span><input id="f-name" name="name" placeholder="Your name" autocomplete="name" /></label>
            <label class="cf-field"><span class="cf-k">Email <em>*</em></span><input id="f-email" name="email" type="email" required placeholder="you@email.com" autocomplete="email" inputmode="email" /></label>
          </div>
          <label class="cf-field"><span class="cf-k">Message <em>*</em></span><textarea id="f-message" name="message" rows="5" required placeholder="What's up?"></textarea></label>

          <div class="cf-row cf-2">
            <label class="cf-field"><span class="cf-k">This is about <small>optional</small></span>
              <select id="f-topic" name="topic">{topics.map((t) => <option value={t.value}>{t.label}</option>)}</select>
            </label>
            <label id="product-wrap" class="cf-field hidden"><span class="cf-k">Which product?</span>
              <select id="f-product" name="product">
                <option value="">Pick one</option>
                {live.map((p) => <option value={p.slug}>{p.title}</option>)}
                <option value="other">Other / not sure</option>
              </select>
            </label>
          </div>
          <p id="plugin-hint" class="cf-hint hidden">Helpful: Stream Deck model, what you pressed, what happened instead, and whether the game or app it talks to was running.</p>

          <!-- honeypot: n8n Screen treats a filled "website" as spam -->
          <div class="hidden" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>

          <div class="cf-foot">
            <button type="submit" class="btn btn-primary">Send it →</button>
            <p id="contact-msg" class="hidden text-sm"></p>
          </div>
        </form>
      </div>

      <p class="mt-10 text-center text-sm text-white/45">Here for the Plex server? <a href="/status" class="text-brand-orange hover:underline">Media &amp; access →</a></p>
    </div>
  </section>


  <style is:global>
    .cf-tile { --rule:#2a2721; --accent:#ff6a00; --accent2:#4f9dff; --mute:#8f8a7d; border:1px solid var(--rule); border-radius:14px; padding:22px 22px 20px; background:rgba(255,255,255,0.02); display:flex; flex-direction:column; gap:18px; }
    .cf-head { display:flex; align-items:baseline; justify-content:space-between; gap:12px; border-bottom:1px solid var(--rule); padding-bottom:12px; }
    .cf-k { display:block; font-family:'Inter',sans-serif; font-size:11px; font-weight:800; letter-spacing:0.16em; text-transform:uppercase; color:var(--accent); }
    .cf-k em { color:var(--accent); font-style:normal; }
    .cf-k small { font-weight:600; letter-spacing:0.08em; text-transform:none; color:var(--mute); margin-left:6px; }
    .cf-live { font-family:'Inter',sans-serif; font-size:10.5px; color:#35d07f; letter-spacing:0.06em; }
    .cf-row { display:grid; gap:18px; }
    @media (min-width:640px) { .cf-2 { grid-template-columns:1fr 1fr; } }
    .cf-field { display:flex; flex-direction:column; gap:6px; min-width:0; }
    .cf-field.hidden, .cf-hint.hidden { display:none; }
    .cf-field input, .cf-field textarea, .cf-field select { width:100%; background:rgba(255,255,255,0.045); border:1px solid #3a362e; border-radius:10px; padding:11px 13px; color:#f3eee2; font-size:15.5px; line-height:1.4; outline:none; transition:border-color .14s ease, background .14s ease, box-shadow .14s ease; }
    .cf-field input:hover, .cf-field textarea:hover, .cf-field select:hover { border-color:#5a554a; }
    .cf-field textarea { resize:vertical; min-height:120px; }
    .cf-field select { appearance:none; -webkit-appearance:none; cursor:pointer; background-image:linear-gradient(45deg, transparent 50%, var(--mute) 50%), linear-gradient(135deg, var(--mute) 50%, transparent 50%); background-position:calc(100% - 20px) 55%, calc(100% - 15px) 55%; background-size:5px 5px, 5px 5px; background-repeat:no-repeat; padding-right:38px; }
    .cf-field select option { background:#0A0E14; color:#e9e4d8; }
    .cf-field input::placeholder, .cf-field textarea::placeholder { color:#7a7568; }
    .cf-field input:focus, .cf-field textarea:focus, .cf-field select:focus { border-color:var(--accent); background:rgba(255,255,255,0.06); box-shadow:0 0 0 3px rgba(255,106,0,0.22); }
    .cf-field input:user-invalid, .cf-field textarea:user-invalid { border-color:#c2410c; }
    .cf-hint { font-size:12.5px; color:var(--mute); line-height:1.5; margin-top:-6px; }
    .cf-foot { display:flex; flex-wrap:wrap; align-items:center; gap:14px; border-top:1px solid var(--rule); padding-top:16px; }
    .cf-foot .btn { padding:10px 22px; }
    #contact-msg.ok { color:#35d07f; } #contact-msg.err { color:#f87171; }
  </style>

  <script>
    const form = document.getElementById('contact-form');
    const msg = document.getElementById('contact-msg');
    const topic = document.getElementById('f-topic');
    const product = document.getElementById('f-product');
    const productWrap = document.getElementById('product-wrap');
    const hint = document.getElementById('plugin-hint');

    function syncTopic() {
      const isPlugin = topic.value === 'plugin';
      productWrap.classList.toggle('hidden', !isPlugin);
      hint.classList.toggle('hidden', !isPlugin);
      if (!isPlugin) product.value = '';
    }
    // deep link: ?topic=plugin&product=<slug>
    const q = new URLSearchParams(location.search);
    if (q.get('topic') && [...topic.options].some((o) => o.value === q.get('topic'))) topic.value = q.get('topic');
    if (q.get('product') && [...product.options].some((o) => o.value === q.get('product'))) product.value = q.get('product');
    topic.addEventListener('change', syncTopic);
    syncTopic();
    // door click preselects the topic
    document.querySelectorAll('a.door[data-topic]').forEach((a) => a.addEventListener('click', () => { topic.value = a.dataset.topic; syncTopic(); }));

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type=submit]');
      const data = new FormData(form);
      const email = (data.get('email') || '').toString().trim();
      const message = (data.get('message') || '').toString().trim();
      if (!email || !message) { show('Email and a message, please.', true); return; }
      const t = topic.value;
      const productSlug = t === 'plugin' ? (data.get('product') || '').toString() : '';
      const productTitle = productSlug ? product.options[product.selectedIndex].text : '';
      const payload = {
        name: (data.get('name') || '').toString().trim(),
        email,
        message,
        topic: t,
        product: productSlug,
        productTitle,
        website: (data.get('website') || '').toString(),
        source: 'allemanit.com/contact',
        submittedAt: new Date().toISOString(),
      };
      btn.disabled = true; btn.textContent = 'Sending...';
      try {
        const res = await fetch(form.dataset.webhook, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('bad status');
        window.umami?.track('form-submit', { site: 'allemanit', form: 'contact', topic: t, outcome: 'success' });
        form.reset(); syncTopic();
        show('Got it. I read every message and will get back to you.', false);
      } catch (err) {
        show('Something broke. Email me directly at duallema@quickitprojects.com.', true);
      } finally {
        btn.disabled = false; btn.textContent = 'Send it →';
      }
    });
    function show(text, isError) {
      msg.textContent = text;
      msg.className = 'text-sm ' + (isError ? 'err' : 'ok');
    }
  </script>
</Base>
