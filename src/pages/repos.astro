---
import Base from '../layouts/Base.astro';
import { groups, counts, reviewed, repoUrl, repoName, repoOwner, repoId } from '../data/repos';

const statusLabel = { running: 'Running', daily: 'Daily tool', tried: 'Tried' };
const statusClass = {
  running: 'border-emerald-400/30 bg-emerald-400/10 text-emerald-300',
  daily: 'border-sky-400/30 bg-sky-400/10 text-sky-300',
  tried: 'border-white/10 bg-white/5 text-white/55',
};
const picks = groups.flatMap((g) => g.repos).filter((r) => r.pick);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Repos I run on',
  url: 'https://allemanit.com/repos/',
  about: { '@id': 'https://allemanit.com/#dustin' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: counts.total,
    itemListElement: groups.flatMap((g) => g.repos).map((r, i) => ({
      '@type': 'ListItem', position: i + 1,
      item: { '@type': 'SoftwareSourceCode', name: repoName(r), codeRepository: repoUrl(r), description: r.why },
    })),
  },
};
---
<Base
  title="Repos I run on | Dustin Alleman"
  description={`The open source under my homelab, my agents and my business: ${counts.total} GitHub repos, ${counts.running} of them running right now, and what I actually use each one for.`}
  url="https://allemanit.com/repos/"
  jsonld={jsonld}
>
  <section class="container-x pt-10 pb-6">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-orange">Open source · the stack under the stack</p>
    <h1 class="mt-3 text-4xl font-extrabold leading-tight text-white sm:text-5xl">Repos I run on.</h1>
    <p class="mt-4 max-w-3xl text-lg text-white/70">
      Almost everything on this site runs on somebody else's open source. These are the repos that earned a spot on one of my boxes, and what I actually use each one for. No affiliate links, no "top 10" padding. If it is on here, it is running, it is a daily tool, or I tried it and can tell you why I stopped.
    </p>
    <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-sm">
      <div><span class="text-2xl font-extrabold text-white">{counts.total}</span> <span class="text-white/60">repos</span></div>
      <div><span class="text-2xl font-extrabold text-white">{counts.running}</span> <span class="text-white/60">running right now</span></div>
      <div><span class="text-2xl font-extrabold text-white">{counts.groups}</span> <span class="text-white/60">lanes</span></div>
    </div>
  </section>

  <!-- jump chips: one row, scrolls sideways on a phone -->
  <nav aria-label="Jump to a section" class="sticky top-16 z-30 border-y border-white/10 bg-ink-950/85 backdrop-blur">
    <div class="container-x -mx-0 flex gap-2 overflow-x-auto py-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <a href="#picks" class="shrink-0 rounded-full border border-brand-orange/40 bg-brand-orange/10 px-3.5 py-2 text-sm font-semibold text-brand-orange">Favorites</a>
      {groups.map((g) => (
        <a href={`#${g.id}`} class="shrink-0 rounded-full border border-white/15 px-3.5 py-2 text-sm text-white/75 hover:border-white/30 hover:text-white">{g.title}</a>
      ))}
    </div>
  </nav>

  <section id="picks" class="container-x scroll-mt-32 py-10">
    <h2 class="text-2xl font-bold text-white">If you only look at {picks.length}</h2>
    <p class="mt-2 max-w-2xl text-white/60">The ones I would install again first on a blank box.</p>
    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {picks.map((r) => (
        <a href={repoUrl(r)} target="_blank" rel="noopener" data-umami-event="outbound-click" data-umami-event-site="allemanit" data-umami-event-destination="github" data-umami-event-placement="repos-pick" data-umami-event-repo={r.slug} class="card group flex min-h-[88px] flex-col justify-between p-4">
          <span class="text-xs text-white/45">{repoOwner(r) || 'self-hosted git'}</span>
          <span class="mt-1 font-bold text-white group-hover:text-brand-orange">{repoName(r)} <span aria-hidden="true" class="text-white/40">↗</span></span>
        </a>
      ))}
    </div>
  </section>

  {groups.map((g) => (
    <section id={g.id} class="container-x scroll-mt-32 py-8">
      <h2 class="text-2xl font-bold text-white">{g.title}</h2>
      <p class="mt-2 max-w-2xl text-white/60">{g.blurb}</p>
      <ul class="mt-5 grid gap-3 md:grid-cols-2">
        {g.repos.map((r) => (
          <li id={repoId(r)} class="scroll-mt-32">
            <a href={repoUrl(r)} target="_blank" rel="noopener" data-umami-event="outbound-click" data-umami-event-site="allemanit" data-umami-event-destination="github" data-umami-event-placement={`repos-${g.id}`} data-umami-event-repo={r.slug} class="card group flex h-full flex-col p-4 sm:p-5">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  {repoOwner(r) && <p class="truncate text-xs text-white/45">{repoOwner(r)} /</p>}
                  <h3 class="break-words font-bold text-white group-hover:text-brand-orange">{repoName(r)} <span aria-hidden="true" class="text-white/40">↗</span></h3>
                </div>
                <span class={`shrink-0 rounded-full border px-2.5 py-0.5 text-xs ${statusClass[r.status]}`}>{statusLabel[r.status]}</span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-white/70">{r.why}</p>
              {r.where && <p class="mt-3 text-xs uppercase tracking-wider text-white/40">{r.where}</p>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="container-x py-10">
    <div class="card flex flex-col items-start justify-between gap-5 p-6 sm:flex-row sm:items-center sm:p-7">
      <div>
        <h2 class="text-xl font-bold text-white">Want to see what I built on top of them?</h2>
        <p class="mt-1 text-white/60">My own repos live on GitHub. The write-ups live here.</p>
      </div>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a href="/projects/" class="btn btn-primary text-sm">See the projects</a>
        <a href="https://github.com/almnjoy" target="_blank" rel="noopener" data-umami-event="outbound-click" data-umami-event-site="allemanit" data-umami-event-destination="github" data-umami-event-placement="repos-footer" class="btn btn-ghost text-sm">github.com/almnjoy</a>
      </div>
    </div>
    <p class="mt-6 text-center text-xs text-white/40">List reviewed {reviewed}. Stars and licenses change; the "why" is what I care about.</p>
  </section>
</Base>
