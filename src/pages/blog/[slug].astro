---
import Editorial from '../../layouts/Editorial.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;
const fmt = (x) => x.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const titleHtml = d.title.replace(/\*(.+?)\*/g, '<em>$1</em>');
const pageUrl = new URL(`/blog/${post.slug}/`, Astro.site).href;
const coverAbs = d.cover ? new URL(d.cover, Astro.site).href : 'https://allemanit.com/og.png';
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'BlogPosting', '@id': `${pageUrl}#post`, headline: d.title, description: d.description, image: coverAbs,
      datePublished: d.date.toISOString(), dateModified: (d.updated || d.date).toISOString(), keywords: d.tags.join(', '),
      author: { '@id': 'https://allemanit.com/#dustin' }, publisher: { '@id': 'https://allemanit.com/#org' },
      mainEntityOfPage: pageUrl, url: pageUrl },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://allemanit.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://allemanit.com/blog/' },
      { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl } ] },
    ...(d.youtube ? [{ '@type': 'VideoObject', name: d.title, description: d.description,
      thumbnailUrl: `https://i.ytimg.com/vi/${d.youtube}/maxresdefault.jpg`, uploadDate: d.date.toISOString(),
      embedUrl: `https://www.youtube-nocookie.com/embed/${d.youtube}`, contentUrl: `https://www.youtube.com/watch?v=${d.youtube}` }] : []),
  ],
};
---
<Editorial title={d.seoTitle ?? ((d.title + ' | The Dispatch').length <= 60 ? `${d.title} | The Dispatch` : d.title)} description={d.description} image={coverAbs} type="article" jsonld={ld}>
  <div class="ed-mast">
    <a class="ed-name" href="/blog">ALMNJOY <b>DISPATCH</b></a>
    <div class="ed-meta">Networking · AI · Homelab</div>
  </div>

  <article class="ed-article">
    <a class="ed-back" href="/blog">← All posts</a>
    <span class="ed-kicker">{d.kicker}</span>
    <h1 class="ed-h1" set:html={titleHtml}></h1>
    <div class="ed-byline">
      By Dustin Alleman · {fmt(d.date)}
      {d.tags.length > 0 && (<span> · {d.tags.map((t) => `#${t}`).join('  ')}</span>)}
    </div>
    {d.cover && (<img class="ed-cover" src={d.cover} alt={d.coverAlt || d.title} loading="lazy" />)}
    <div class="ed-prose"><Content /></div>
  </article>

  <span class="ed-footnote">Got a take or a correction? <a href="/contact">Hit me →</a> · <a href="/daily">The daily log →</a></span>
  <script is:inline define:vars={{ slug: post.slug }}>
    // Tag every external link in a post as an outbound-click so Umami shows where readers go next.
    document.querySelectorAll('.ed-prose a[href^="http"]').forEach((a) => {
      try {
        const u = new URL(a.href);
        if (u.hostname === location.hostname || a.hasAttribute('data-umami-event')) return;
        a.setAttribute('data-umami-event', 'outbound-click');
        a.setAttribute('data-umami-event-site', 'allemanit');
        a.setAttribute('data-umami-event-destination', u.hostname.replace(/^www\./, ''));
        a.setAttribute('data-umami-event-placement', 'blog-' + slug);
      } catch (e) {}
    });
  </script>
</Editorial>
